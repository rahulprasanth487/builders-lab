<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Builders Lab – CODE. CREATE. CONNECT.</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;900&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet"/>

<style>
/* ===========================
   CSS VARIABLES & RESET
=========================== */
:root {
  --bg-gradient: radial-gradient(circle at top, #0B0C10, #1F1B2E);
  --cyan: #00F0FF;
  --pink: #FF5E7E;
  --white: #FFFFFF;
  --body-text: #E0E0E0;
  --glass-bg: rgba(255,255,255,0.05);
  --glass-border: rgba(0,240,255,0.2);
  --glow-cyan: 0 0 15px rgba(0,240,255,0.5);
  --glow-pink: 0 0 15px rgba(255,94,126,0.5);
  --font-head: 'Poppins', sans-serif;
  --font-body: 'Inter', sans-serif;
}

*,*::before,*::after { box-sizing:border-box; margin:0; padding:0; }
html { scroll-behavior:smooth; }

body {
  font-family: var(--font-body);
  background: var(--bg-gradient);
  background-attachment: fixed;
  color: var(--body-text);
  overflow-x: hidden;
  min-height: 100vh;
}

/* ===========================
   SCROLLBAR
=========================== */
::-webkit-scrollbar { width:6px; }
::-webkit-scrollbar-track { background:#0B0C10; }
::-webkit-scrollbar-thumb { background:var(--cyan); border-radius:3px; }

/* ===========================
   NOISE OVERLAY
=========================== */
body::before {
  content:'';
  position:fixed; inset:0;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
  pointer-events:none; z-index:0; opacity:0.4;
}

/* ===========================
   WEBGL FALLBACK
=========================== */
.webgl-fallback {
  display:none;
  position:absolute; inset:0;
  background: radial-gradient(ellipse at center, rgba(0,240,255,0.1) 0%, transparent 70%);
  pointer-events:none;
}
.no-webgl .webgl-fallback { display:block; }
.no-webgl canvas { display:none !important; }

/* ===========================
   NAV
=========================== */
nav {
  position: fixed; top:0; left:0; right:0; z-index:1000;
  display:flex; align-items:center; justify-content:space-between;
  padding:1rem 4%;
  backdrop-filter: blur(20px);
  background: rgba(11,12,16,0.6);
  border-bottom:1px solid rgba(0,240,255,0.1);
  transition: all 0.3s;
}
nav.scrolled {
  padding:0.6rem 4%;
  background: rgba(11,12,16,0.9);
  border-bottom-color: rgba(0,240,255,0.25);
}
.nav-logo {
  font-family: var(--font-head);
  font-weight:900;
  font-size:1.5rem;
  color:var(--white);
  letter-spacing:-0.02em;
  text-decoration:none;
}
.nav-logo span { color:var(--cyan); }
.nav-links { display:flex; gap:2rem; list-style:none; }
.nav-links a {
  color:var(--body-text); text-decoration:none;
  font-size:0.9rem; font-weight:500; letter-spacing:0.05em;
  transition:color 0.2s;
  position:relative;
}
.nav-links a::after {
  content:''; position:absolute; bottom:-4px; left:0; right:0;
  height:2px; background:var(--cyan);
  transform:scaleX(0); transform-origin:left;
  transition:transform 0.3s;
}
.nav-links a:hover { color:var(--cyan); }
.nav-links a:hover::after { transform:scaleX(1); }
.nav-cta {
  background: transparent;
  border:1px solid var(--cyan);
  color:var(--cyan);
  padding:0.5rem 1.4rem;
  border-radius:4px;
  font-family:var(--font-head);
  font-weight:600; font-size:0.85rem; letter-spacing:0.08em;
  cursor:pointer; text-decoration:none;
  transition:all 0.3s;
}
.nav-cta:hover {
  background:var(--cyan); color:#0B0C10;
  box-shadow:var(--glow-cyan);
}
.hamburger { display:none; flex-direction:column; gap:5px; cursor:pointer; }
.hamburger span { display:block; width:24px; height:2px; background:var(--cyan); transition:all 0.3s; }

/* ===========================
   HERO
=========================== */
#hero {
  position:relative; height:100vh; min-height:600px;
  display:flex; align-items:center; justify-content:center;
  overflow:hidden;
}
#hero-canvas {
  position:absolute; inset:0; z-index:1;
}
.hero-content {
  position:relative; z-index:2;
  text-align:center; padding:0 1rem;
  pointer-events:none;
}
.hero-badge {
  display:inline-block;
  border:1px solid rgba(0,240,255,0.4);
  color:var(--cyan);
  padding:0.35rem 1.2rem;
  border-radius:100px;
  font-size:0.75rem; letter-spacing:0.2em; font-weight:600;
  font-family:var(--font-head);
  margin-bottom:1.5rem;
  backdrop-filter:blur(10px);
  background:rgba(0,240,255,0.05);
}
.hero-headline {
  font-family:var(--font-head);
  font-size:clamp(2.5rem,7vw,5.5rem);
  font-weight:900;
  line-height:1.05;
  color:var(--white);
  text-shadow:0 0 60px rgba(0,240,255,0.2);
  margin-bottom:0.5rem;
}
.hero-headline .line2 { color:var(--cyan); display:block; }
.hero-slogan {
  font-family:var(--font-head);
  font-size:clamp(0.85rem,2vw,1.1rem);
  letter-spacing:0.18em;
  color:var(--body-text);
  margin:1.2rem 0 2.5rem;
  font-weight:300;
}
.hero-slogan strong { color:var(--cyan); font-weight:600; }
.hero-buttons { display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; pointer-events:all; }
.btn-primary {
  background:var(--cyan); color:#0B0C10;
  padding:0.8rem 2.2rem; border-radius:6px;
  font-family:var(--font-head); font-weight:700;
  font-size:0.9rem; letter-spacing:0.08em;
  border:none; cursor:pointer; text-decoration:none;
  transition:all 0.3s;
  box-shadow: var(--glow-cyan);
}
.btn-primary:hover {
  transform:translateY(-2px);
  box-shadow:0 0 30px rgba(0,240,255,0.7);
}
.btn-outline {
  background:transparent; color:var(--white);
  padding:0.8rem 2.2rem; border-radius:6px;
  font-family:var(--font-head); font-weight:600;
  font-size:0.9rem; letter-spacing:0.08em;
  border:1px solid rgba(255,255,255,0.3); cursor:pointer; text-decoration:none;
  transition:all 0.3s;
}
.btn-outline:hover {
  border-color:var(--pink); color:var(--pink);
  box-shadow:var(--glow-pink);
}
.scroll-hint {
  position:absolute; bottom:2rem; left:50%; transform:translateX(-50%);
  display:flex; flex-direction:column; align-items:center; gap:0.5rem;
  z-index:2; opacity:0.6;
  animation: bobDown 2s ease-in-out infinite;
}
.scroll-hint span { font-size:0.7rem; letter-spacing:0.15em; color:var(--body-text); }
.scroll-arrow { width:1px; height:40px; background:linear-gradient(to bottom, var(--cyan), transparent); }
@keyframes bobDown {
  0%,100%{transform:translateX(-50%) translateY(0)}
  50%{transform:translateX(-50%) translateY(8px)}
}

/* ===========================
   SECTION COMMONS
=========================== */
section { position:relative; z-index:1; }
.section-inner { max-width:1200px; margin:0 auto; padding:6rem 5%; }
.section-tag {
  display:inline-block;
  color:var(--cyan); font-size:0.75rem;
  letter-spacing:0.25em; font-weight:600;
  font-family:var(--font-head); text-transform:uppercase;
  margin-bottom:0.8rem;
}
.section-title {
  font-family:var(--font-head);
  font-size:clamp(2rem,4vw,3rem);
  font-weight:900; color:var(--white);
  line-height:1.1; margin-bottom:1rem;
}
.section-title span { color:var(--cyan); }
.section-sub {
  font-size:1rem; color:var(--body-text);
  max-width:600px; line-height:1.7;
}

/* ===========================
   FEATURES / USPs
=========================== */
#features { background:rgba(0,0,0,0.2); }
.features-grid {
  display:grid;
  grid-template-columns: repeat(3,1fr);
  gap:2rem; margin-top:3rem;
}
.feature-card {
  background:var(--glass-bg);
  backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,0.06);
  border-radius:16px;
  padding:2.5rem 2rem;
  transition:all 0.4s;
  position:relative; overflow:hidden;
}
.feature-card::before {
  content:''; position:absolute;
  top:0; left:0; right:0; height:2px;
  background:linear-gradient(90deg, transparent, var(--cyan), transparent);
  transform:scaleX(0); transition:transform 0.4s;
}
.feature-card:hover { border-color:var(--glass-border); box-shadow:var(--glow-cyan); }
.feature-card:hover::before { transform:scaleX(1); }
.feature-icon {
  font-size:2.5rem; margin-bottom:1.2rem; display:block;
  filter:drop-shadow(0 0 8px rgba(0,240,255,0.5));
}
.feature-title {
  font-family:var(--font-head); font-size:1.1rem;
  font-weight:700; color:var(--white); letter-spacing:0.05em;
  margin-bottom:0.8rem;
}
.feature-desc { font-size:0.92rem; line-height:1.7; color:var(--body-text); }
.feature-num {
  position:absolute; top:1.5rem; right:1.8rem;
  font-family:var(--font-head); font-size:3rem;
  font-weight:900; color:rgba(0,240,255,0.06);
  line-height:1;
}

/* ===========================
   SERVICES
=========================== */
#services { background:rgba(31,27,46,0.4); }
.services-header { margin-bottom:1rem; }
.services-grid {
  display:grid;
  grid-template-columns: repeat(auto-fit, minmax(200px,1fr));
  gap:1.5rem; margin-top:3rem;
}
.service-card {
  background:var(--glass-bg);
  backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,0.06);
  border-radius:16px;
  padding:2rem 1.5rem;
  text-align:center;
  transition:all 0.4s; cursor:pointer;
  position:relative; overflow:hidden;
}
.service-card:hover {
  border-color:var(--glass-border);
  box-shadow:var(--glow-cyan);
  transform:translateY(-6px);
}
.service-canvas-wrap {
  width:100%; height:140px;
  margin-bottom:1.2rem;
  border-radius:10px; overflow:hidden;
  background:rgba(0,240,255,0.03);
}
.service-canvas-wrap canvas { width:100%!important; height:100%!important; }
.service-title {
  font-family:var(--font-head); font-size:0.85rem;
  font-weight:700; color:var(--white);
  letter-spacing:0.1em; text-transform:uppercase;
}
.service-desc { font-size:0.8rem; color:var(--body-text); margin-top:0.5rem; line-height:1.6; }

/* ===========================
   3D SHOWCASE
=========================== */
#showcase { background:rgba(0,0,0,0.3); }
.showcase-layout {
  display:grid; grid-template-columns:1fr 1fr;
  gap:4rem; align-items:center;
  margin-top:3rem;
}
#showcase-canvas {
  width:100%; height:450px;
  border-radius:20px; border:1px solid rgba(0,240,255,0.15);
  background:rgba(0,0,0,0.3);
  backdrop-filter:blur(10px);
}
.showcase-info { }
.showcase-info p { line-height:1.8; margin-bottom:1.5rem; }
.showcase-info .btn-primary { pointer-events:all; display:inline-block; }
.orbit-hint {
  display:inline-flex; align-items:center; gap:0.5rem;
  background:rgba(0,240,255,0.08); border:1px solid rgba(0,240,255,0.2);
  border-radius:8px; padding:0.5rem 1rem;
  font-size:0.78rem; color:var(--cyan); letter-spacing:0.05em;
  margin-bottom:2rem;
}

/* ===========================
   ABOUT / OUR LAB
=========================== */
#about { }
.about-layout {
  display:grid; grid-template-columns:1fr 1fr;
  gap:4rem; align-items:center; margin-top:3rem;
}
.about-text { }
.about-text p { line-height:1.8; margin-bottom:1rem; }
.stats-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-top:2rem; }
.stat-box {
  background:var(--glass-bg); backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,0.06);
  border-radius:12px; padding:1.5rem; text-align:center;
  transition:all 0.3s;
}
.stat-box:hover { border-color:var(--glass-border); box-shadow:var(--glow-cyan); }
.stat-num {
  font-family:var(--font-head); font-size:2.2rem; font-weight:900;
  color:var(--cyan); display:block; margin-bottom:0.3rem;
}
.stat-label { font-size:0.8rem; color:var(--body-text); letter-spacing:0.05em; }
#flask-canvas {
  width:100%; height:400px; border-radius:20px;
  background:rgba(0,0,0,0.2); border:1px solid rgba(255,255,255,0.05);
}

/* ===========================
   CONTACT
=========================== */
#contact { background:rgba(0,0,0,0.3); }
.contact-layout {
  display:grid; grid-template-columns:1fr 1fr;
  gap:4rem; align-items:start; margin-top:3rem;
}
#contact-canvas {
  width:100%; height:400px; border-radius:16px;
  background:rgba(0,0,0,0.2); border:1px solid rgba(255,255,255,0.04);
}
.contact-form-wrap { }
.contact-form-wrap p { margin-bottom:2rem; line-height:1.7; }
.form-group { margin-bottom:1.2rem; }
.form-group label {
  display:block; font-size:0.78rem;
  letter-spacing:0.12em; color:var(--cyan);
  font-weight:600; margin-bottom:0.4rem;
  font-family:var(--font-head);
}
.form-group input,
.form-group textarea {
  width:100%; background:rgba(255,255,255,0.04);
  border:1px solid rgba(255,255,255,0.1);
  border-radius:8px; padding:0.85rem 1rem;
  color:var(--white); font-family:var(--font-body);
  font-size:0.9rem; outline:none;
  transition:all 0.3s; resize:none;
}
.form-group input:focus,
.form-group textarea:focus {
  border-color:var(--cyan);
  box-shadow:0 0 0 3px rgba(0,240,255,0.08);
}
.form-group input::placeholder,
.form-group textarea::placeholder { color:rgba(255,255,255,0.3); }
.form-group textarea { height:120px; }
.btn-submit {
  width:100%; background:var(--cyan); color:#0B0C10;
  border:none; padding:1rem;
  border-radius:8px; font-family:var(--font-head);
  font-weight:700; font-size:0.95rem; letter-spacing:0.1em;
  cursor:pointer; transition:all 0.3s;
  box-shadow:var(--glow-cyan);
}
.btn-submit:hover {
  transform:translateY(-2px);
  box-shadow:0 0 30px rgba(0,240,255,0.7);
}
.btn-submit:disabled { opacity:0.6; cursor:not-allowed; }
.sent-message {
  display:none; text-align:center; padding:2rem;
  color:var(--cyan); font-family:var(--font-head);
  font-size:1.4rem; font-weight:700;
}

/* ===========================
   FOOTER
=========================== */
footer {
  background:rgba(0,0,0,0.5);
  border-top:1px solid rgba(0,240,255,0.1);
  padding:4rem 5% 2rem;
}
.footer-inner { max-width:1200px; margin:0 auto; }
.footer-top {
  display:grid; grid-template-columns:2fr 1fr 1fr;
  gap:3rem; margin-bottom:3rem;
}
.footer-brand .nav-logo { font-size:1.8rem; display:inline-block; margin-bottom:1rem; text-decoration:none; }
.footer-brand p { font-size:0.9rem; line-height:1.7; max-width:280px; }
.footer-tagline {
  font-family:var(--font-head);
  font-size:0.75rem; letter-spacing:0.2em;
  color:var(--cyan); margin-bottom:0.3rem; display:block;
}
.footer-col h4 {
  font-family:var(--font-head); font-weight:700;
  color:var(--white); font-size:0.9rem;
  letter-spacing:0.1em; margin-bottom:1.2rem;
  text-transform:uppercase;
}
.footer-col ul { list-style:none; }
.footer-col ul li { margin-bottom:0.6rem; }
.footer-col ul li a, .footer-col ul li span {
  color:var(--body-text); text-decoration:none;
  font-size:0.88rem; transition:color 0.2s;
  display:flex; align-items:center; gap:0.5rem;
}
.footer-col ul li a:hover { color:var(--cyan); }
.footer-bottom {
  border-top:1px solid rgba(255,255,255,0.06);
  padding-top:2rem;
  display:flex; align-items:center; justify-content:space-between;
  flex-wrap:wrap; gap:1rem;
}
.footer-bottom p { font-size:0.8rem; color:rgba(255,255,255,0.4); }
.footer-bottom .made-with { color:var(--pink); }
.footer-cta {
  text-align:center; padding:3rem 1rem;
  background:linear-gradient(135deg, rgba(0,240,255,0.08), rgba(255,94,126,0.08));
  border-radius:20px; margin-bottom:3rem;
  border:1px solid rgba(0,240,255,0.12);
}
.footer-cta h2 {
  font-family:var(--font-head); font-size:clamp(1.5rem,3vw,2.2rem);
  font-weight:900; color:var(--white); margin-bottom:0.5rem;
}
.footer-cta h2 span { color:var(--cyan); }
.footer-cta p { margin-bottom:1.5rem; font-size:0.95rem; }

/* ===========================
   ANIMATIONS & UTILITIES
=========================== */
.reveal-up {
  opacity:0; transform:translateY(40px);
  transition:all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
.reveal-up.visible { opacity:1; transform:translateY(0); }
.reveal-delay-1 { transition-delay:0.1s; }
.reveal-delay-2 { transition-delay:0.2s; }
.reveal-delay-3 { transition-delay:0.3s; }

/* gradient glow divider */
.glow-divider {
  height:1px; background:linear-gradient(90deg, transparent, var(--cyan), transparent);
  opacity:0.3; margin:0;
}

/* ===========================
   MOBILE MENU
=========================== */
.mobile-menu {
  display:none; position:fixed; inset:0;
  background:rgba(11,12,16,0.98);
  backdrop-filter:blur(20px);
  z-index:999;
  flex-direction:column; align-items:center; justify-content:center; gap:2.5rem;
}
.mobile-menu.open { display:flex; }
.mobile-menu a {
  color:var(--white); text-decoration:none;
  font-family:var(--font-head); font-size:1.8rem;
  font-weight:700; letter-spacing:0.05em;
  transition:color 0.2s;
}
.mobile-menu a:hover { color:var(--cyan); }
.mobile-close {
  position:absolute; top:1.5rem; right:1.5rem;
  color:var(--body-text); font-size:2rem;
  cursor:pointer; background:none; border:none;
  line-height:1;
}

/* ===========================
   RESPONSIVE
=========================== */
@media (max-width:900px) {
  .features-grid { grid-template-columns:1fr; }
  .showcase-layout { grid-template-columns:1fr; }
  #showcase-canvas { height:300px; }
  .about-layout { grid-template-columns:1fr; }
  #flask-canvas { height:280px; order:-1; }
  .contact-layout { grid-template-columns:1fr; }
  #contact-canvas { height:260px; }
  .footer-top { grid-template-columns:1fr; gap:2rem; }
  .nav-links, .nav-cta { display:none; }
  .hamburger { display:flex; }
}
@media (max-width:600px) {
  .services-grid { grid-template-columns:repeat(2,1fr); }
  .stats-grid { grid-template-columns:1fr 1fr; }
  .section-inner { padding:4rem 5%; }
  .hero-buttons { flex-direction:column; align-items:center; }
}
@media (max-width:400px) {
  .services-grid { grid-template-columns:1fr; }
}
</style>
</head>
<body>

<!-- ========== NAV ========== -->
<nav id="navbar">
  <a href="#hero" class="nav-logo">Builders<span>Lab</span></a>
  <ul class="nav-links">
    <li><a href="#features">Features</a></li>
    <li><a href="#services">Services</a></li>
    <li><a href="#showcase">Showcase</a></li>
    <li><a href="#about">About</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
  <a href="#contact" class="nav-cta">GET STARTED</a>
  <div class="hamburger" id="hamburger">
    <span></span><span></span><span></span>
  </div>
</nav>

<!-- Mobile menu -->
<div class="mobile-menu" id="mobileMenu">
  <button class="mobile-close" id="mobileClose">✕</button>
  <a href="#features" onclick="closeMobileMenu()">Features</a>
  <a href="#services" onclick="closeMobileMenu()">Services</a>
  <a href="#showcase" onclick="closeMobileMenu()">Showcase</a>
  <a href="#about" onclick="closeMobileMenu()">About</a>
  <a href="#contact" onclick="closeMobileMenu()">Contact</a>
</div>

<!-- ========== HERO ========== -->
<section id="hero">
  <canvas id="hero-canvas"></canvas>
  <div class="webgl-fallback"></div>
  <div class="hero-content">
    <div class="hero-badge">CODE · CREATE · CONNECT</div>
    <h1 class="hero-headline">
      Your Vision.
      <span class="line2">Our Code.</span>
    </h1>
    <p class="hero-slogan">WE BUILD WEBSITES THAT <strong>BUILD BUSINESSES</strong></p>
    <div class="hero-buttons">
      <a href="#services" class="btn-primary">EXPLORE SERVICES</a>
      <a href="#contact" class="btn-outline">START A PROJECT</a>
    </div>
  </div>
  <div class="scroll-hint">
    <span>SCROLL</span>
    <div class="scroll-arrow"></div>
  </div>
</section>

<div class="glow-divider"></div>

<!-- ========== FEATURES (USPs) ========== -->
<section id="features">
  <div class="section-inner">
    <span class="section-tag reveal-up">WHY BUILDERS LAB</span>
    <h2 class="section-title reveal-up">Built to <span>Perform</span></h2>
