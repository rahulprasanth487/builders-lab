<!-- ===========================
     THREE.JS CDN
=========================== -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<script>
/* ===================================================
   GLOBAL STATE & UTILS
=================================================== */
const isMobile = window.innerWidth < 768;
const observers = [];

// Check WebGL support
function hasWebGL() {
  try {
    const c = document.createElement('canvas');
    return !!(window.WebGLRenderingContext &&
      (c.getContext('webgl') || c.getContext('experimental-webgl')));
  } catch(e) { return false; }
}
if (!hasWebGL()) document.body.classList.add('no-webgl');

// Nav scroll effect
const navbar = document.getElementById('navbar');
window.addEventListener('scroll', () => {
  navbar.classList.toggle('scrolled', window.scrollY > 50);
});

// Mobile menu
document.getElementById('hamburger').addEventListener('click', () => {
  document.getElementById('mobileMenu').classList.add('open');
});
document.getElementById('mobileClose').addEventListener('click', closeMobileMenu);
function closeMobileMenu() {
  document.getElementById('mobileMenu').classList.remove('open');
}

// Reveal on scroll
const revealEls = document.querySelectorAll('.reveal-up');
const revealObs = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.12 });
revealEls.forEach(el => revealObs.observe(el));

/* ===================================================
   HELPER: Create renderer
=================================================== */
function createRenderer(canvas, alpha=true) {
  const r = new THREE.WebGLRenderer({
    canvas, alpha, antialias:!isMobile,
    powerPreference:'high-performance'
  });
  r.setPixelRatio(Math.min(window.devicePixelRatio, isMobile ? 1.5 : 2));
  return r;
}

/* ===================================================
   SECTION 1: HERO – CUBE SWARM
   20–30 cubes rotating, scatter on scroll, reform
=================================================== */
(function initHero() {
  const canvas = document.getElementById('hero-canvas');
  if (!hasWebGL()) return;

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(60, window.innerWidth/window.innerHeight, 0.1, 200);
  camera.position.set(0, 0, 30);
  const renderer = createRenderer(canvas);
  renderer.setSize(window.innerWidth, window.innerHeight);

  // Cube count
  const COUNT = isMobile ? 15 : 25;
  const cubes = [];
  const targetPositions = [];
  const scatterPositions = [];
  let scattered = false;
  let scrollY = 0;

  // Materials
  const edgeMat = new THREE.LineBasicMaterial({
    color:0x00F0FF, transparent:true, opacity:0.7
  });

  for (let i = 0; i < COUNT; i++) {
    const size = 0.4 + Math.random() * 1.2;
    const geo = new THREE.BoxGeometry(size, size, size);
    const edges = new THREE.EdgesGeometry(geo);
    const line = new THREE.LineSegments(edges, edgeMat.clone());

    // Target (swarm) position
    const theta = Math.random() * Math.PI * 2;
    const phi = Math.acos(2 * Math.random() - 1);
    const r = 5 + Math.random() * 12;
    const tx = r * Math.sin(phi) * Math.cos(theta);
    const ty = r * Math.sin(phi) * Math.sin(theta) * 0.5;
    const tz = r * Math.cos(phi) * 0.5;

    line.position.set(tx, ty, tz);
    line.rotation.set(Math.random()*Math.PI, Math.random()*Math.PI, Math.random()*Math.PI);

    targetPositions.push({ x:tx, y:ty, z:tz });
    scatterPositions.push({
      x:(Math.random()-0.5)*80,
      y:(Math.random()-0.5)*50 - 30,
      z:(Math.random()-0.5)*60
    });

    const speed = 0.003 + Math.random()*0.008;
    cubes.push({ mesh:line, rotSpeed:{x:speed, y:speed*1.3, z:speed*0.7}, phase:Math.random()*Math.PI*2 });
    scene.add(line);
  }

  // Ambient glow sphere
  const glowGeo = new THREE.SphereGeometry(3, 16, 16);
  const glowMat = new THREE.MeshBasicMaterial({
    color:0x00F0FF, transparent:true, opacity:0.04, wireframe:true
  });
  const glowSphere = new THREE.Mesh(glowGeo, glowMat);
  scene.add(glowSphere);

  // Subtle star field
  const starGeo = new THREE.BufferGeometry();
  const starCount = isMobile ? 300 : 600;
  const starPos = new Float32Array(starCount * 3);
  for (let i = 0; i < starCount * 3; i++) starPos[i] = (Math.random()-0.5)*200;
  starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
  const starMat = new THREE.PointsMaterial({ color:0xffffff, size:0.15, transparent:true, opacity:0.5 });
  scene.add(new THREE.Points(starGeo, starMat));

  let t = 0;
  function animate() {
    requestAnimationFrame(animate);
    t += 0.01;

    const scrollFrac = Math.min(scrollY / (window.innerHeight * 0.8), 1);

    cubes.forEach((c, i) => {
      const target = scrollFrac > 0.1 ? scatterPositions[i] : targetPositions[i];
      c.mesh.position.x += (target.x - c.mesh.position.x) * 0.04;
      c.mesh.position.y += (target.y - c.mesh.position.y) * 0.04;
      c.mesh.position.z += (target.z - c.mesh.position.z) * 0.04;
      c.mesh.rotation.x += c.rotSpeed.x;
      c.mesh.rotation.y += c.rotSpeed.y;
      // Pulse opacity
      c.mesh.material.opacity = 0.4 + 0.3 * Math.sin(t + c.phase);
    });

    // Slow swarm orbit
    scene.rotation.y = t * 0.1;
    glowSphere.rotation.y = -t * 0.05;

    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('scroll', () => { scrollY = window.scrollY; });
  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth/window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  });
})();

/* ===================================================
   SECTION 2: SERVICES – 5 FLOATING 3D ICONS
   Gear, Rocket, Chart, Mobile, Wrench
   Each card has its own mini Three.js canvas
=================================================== */
(function initServices() {
  if (!hasWebGL()) return;

  const colors = [0x00F0FF, 0xFF5E7E, 0x00F0FF, 0xFF5E7E, 0x00F0FF];

  // Factory functions for service icons
  function makeGear(scene) {
    const g = new THREE.Group();
    // Main circle
    const outerR = new THREE.TorusGeometry(1, 0.2, 8, 12);
    const torus = new THREE.Mesh(outerR, new THREE.MeshStandardMaterial({color:0x00F0FF, emissive:0x00F0FF, emissiveIntensity:0.4, metalness:0.8, roughness:0.2}));
    g.add(torus);
    // Teeth
    for (let i = 0; i < 8; i++) {
      const a = (i/8)*Math.PI*2;
      const tooth = new THREE.Mesh(new THREE.BoxGeometry(0.25,0.5,0.25),
        new THREE.MeshStandardMaterial({color:0x00F0FF,emissive:0x00F0FF,emissiveIntensity:0.3}));
      tooth.position.set(Math.cos(a)*1.2, Math.sin(a)*1.2, 0);
      tooth.rotation.z = a;
      g.add(tooth);
    }
    // Center
    const center = new THREE.Mesh(new THREE.CylinderGeometry(0.3,0.3,0.3,16),
      new THREE.MeshStandardMaterial({color:0x00F0FF,emissive:0x00F0FF,emissiveIntensity:0.6}));
    center.rotation.x = Math.PI/2;
    g.add(center);
    scene.add(g);
    return g;
  }

  function makeRocket(scene) {
    const g = new THREE.Group();
    // Body
    const body = new THREE.Mesh(new THREE.CylinderGeometry(0.4,0.5,2,8),
      new THREE.MeshStandardMaterial({color:0xFF5E7E,emissive:0xFF5E7E,emissiveIntensity:0.3,metalness:0.7}));
    g.add(body);
    // Nose
    const nose = new THREE.Mesh(new THREE.ConeGeometry(0.4,0.9,8),
      new THREE.MeshStandardMaterial({color:0xFF5E7E,emissive:0xFF5E7E,emissiveIntensity:0.4}));
    nose.position.y = 1.45;
    g.add(nose);
    // Fins
    for (let i = 0; i < 3; i++) {
      const fin = new THREE.Mesh(new THREE.BoxGeometry(0.1,0.6,0.5),
        new THREE.MeshStandardMaterial({color:0xFF8FA0}));
      fin.rotation.y = (i/3)*Math.PI*2;
      fin.position.set(Math.cos((i/3)*Math.PI*2)*0.5, -0.8, Math.sin((i/3)*Math.PI*2)*0.5);
      g.add(fin);
    }
    // Exhaust glow
    const exhaust = new THREE.Mesh(new THREE.SphereGeometry(0.3,8,8),
      new THREE.MeshBasicMaterial({color:0xFFAA00,transparent:true,opacity:0.8}));
    exhaust.position.y = -1.3;
    g.add(exhaust);
    scene.add(g);
    return g;
  }

  function makeChart(scene) {
    const g = new THREE.Group();
    const heights=[0.6,1.1,0.8,1.5,1.2];
    const col=[0x00F0FF,0x00D4E8,0xFF5E7E,0x00F0FF,0xFF5E7E];
    heights.forEach((h,i)=>{
      const bar = new THREE.Mesh(new THREE.BoxGeometry(0.35,h,0.35),
        new THREE.MeshStandardMaterial({color:col[i],emissive:col[i],emissiveIntensity:0.3}));
      bar.position.set(-1.0+i*0.5, h/2-1.2, 0);
      g.add(bar);
    });
    // Trend line
    const curve = new THREE.CatmullRomCurve3([
      new THREE.Vector3(-1,-.6,0.2),new THREE.Vector3(-0.5,-.1,0.2),
      new THREE.Vector3(0,-.4,0.2),new THREE.Vector3(0.5,.3,0.2),new THREE.Vector3(1,.1,0.2)
    ]);
    const pts = curve.getPoints(30);
    const lineGeo = new THREE.BufferGeometry().setFromPoints(pts);
    const ln = new THREE.Line(lineGeo, new THREE.LineBasicMaterial({color:0xFFFF00}));
    g.add(ln);
    scene.add(g);
    return g;
  }

  function makeMobile(scene) {
    const g = new THREE.Group();
    // Phone body
    const body = new THREE.Mesh(new THREE.BoxGeometry(1.1,1.9,0.15),
      new THREE.MeshStandardMaterial({color:0x222244,metalness:0.9,roughness:0.1}));
    g.add(body);
    // Screen
    const screen = new THREE.Mesh(new THREE.BoxGeometry(0.9,1.55,0.16),
      new THREE.MeshStandardMaterial({color:0x00F0FF,emissive:0x00F0FF,emissiveIntensity:0.5}));
    screen.position.z = 0.01;
    g.add(screen);
    // Camera
    const cam = new THREE.Mesh(new THREE.SphereGeometry(0.07,8,8),
      new THREE.MeshStandardMaterial({color:0x111111,metalness:1}));
    cam.position.set(0,0.83,0.1);
    g.add(cam);
    scene.add(g);
    return g;
  }

  function makeWrench(scene) {
    const g = new THREE.Group();
    // Handle
    const handle = new THREE.Mesh(new THREE.CylinderGeometry(0.15,0.15,2,8),
      new THREE.MeshStandardMaterial({color:0x888888,metalness:0.9,roughness:0.2}));
    g.add(handle);
    // Head
    const head = new THREE.Mesh(new THREE.TorusGeometry(0.4,0.15,8,8,Math.PI),
      new THREE.MeshStandardMaterial({color:0xFF5E7E,emissive:0xFF5E7E,emissiveIntensity:0.3,metalness:0.8}));
    head.position.y = 1.1;
    head.rotation.z = Math.PI/2;
    g.add(head);
    scene.add(g);
    return g;
  }

  const makers = [makeGear, makeRocket, makeChart, makeMobile, makeWrench];

  makers.forEach((maker, idx) => {
    const canvas = document.getElementById(`svc${idx}`);
    if (!canvas) return;

    const w = canvas.offsetWidth || 200;
    const h = 140;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(50, w/h, 0.1, 100);
    camera.position.set(0, 0, 5);
    const renderer = createRenderer(canvas);
    renderer.setSize(w, h);

    // Lighting
    scene.add(new THREE.AmbientLight(0xffffff, 0.3));
    const pt = new THREE.PointLight(colors[idx], 2, 20);
    pt.position.set(3, 3, 3);
    scene.add(pt);
    const pt2 = new THREE.PointLight(0xffffff, 0.5, 20);
    pt2.position.set(-3,-3,-3);
    scene.add(pt2);

    const obj = maker(scene);
    obj.scale.set(0.6,0.6,0.6);

    // Particle burst on hover
    let particleBurst = null;
    const card = canvas.closest('.service-card');

    card.addEventListener('mouseenter', () => {
      // Create burst particles
      if (particleBurst) scene.remove(particleBurst);
      const pGeo = new THREE.BufferGeometry();
      const pCount = 30;
      const pPos = new Float32Array(pCount * 3);
      const pVel = [];
      for (let i = 0; i < pCount; i++) {
        pPos[i*3] = (Math.random()-0.5)*0.5;
        pPos[i*3+1] = (Math.random()-0.5)*0.5;
        pPos[i*3+2] = (Math.random()-0.5)*0.5;
        pVel.push({x:(Math.random()-0.5)*0.15,y:(Math.random()-0.5)*0.15+0.05,z:0});
      }
      pGeo.setAttribute('position', new THREE.BufferAttribute(pPos,3));
      particleBurst = new THREE.Points(pGeo,
        new THREE.PointsMaterial({color:colors[idx],size:0.1,transparent:true,opacity:1}));
      particleBurst.userData = {vel:pVel, life:1.0};
      scene.add(particleBurst);
    });

    let bobT = Math.random()*Math.PI*2;
    function animate() {
      requestAnimationFrame(animate);
      bobT += 0.02;
      obj.position.y = Math.sin(bobT) * 0.15;
      obj.rotation.y += 0.012;

      if (particleBurst) {
        particleBurst.userData.life -= 0.02;
        const pos = particleBurst.geometry.attributes.position.array;
        const vel = particleBurst.userData.vel;
        for (let i = 0; i < vel.length; i++) {
          pos[i*3] += vel[i].x;
          pos[i*3+1] += vel[i].y;
          pos[i*3+2] += vel[i].z;
          vel[i].y -= 0.003;
        }
        particleBurst.geometry.attributes.position.needsUpdate = true;
        particleBurst.material.opacity = particleBurst.userData.life;
        if (particleBurst.userData.life <= 0) { scene.remove(particleBurst); particleBurst=null; }
      }
      renderer.render(scene, camera);
    }
    animate();
  });
})();

/* ===================================================
   SECTION 3: SHOWCASE – Abstract Tech Device
   + OrbitControls + Pulsating wireframe sphere
=================================================== */
(function initShowcase() {
  const canvas = document.getElementById('showcase-canvas');
  if (!hasWebGL()) return;

  const scene = new THREE.Scene();
  const w = canvas.offsetWidth || 500;
  const h = 450;
  const camera = new THREE.PerspectiveCamera(55, w/h, 0.1, 100);
  camera.position.set(0, 2, 8);
  const renderer = createRenderer(canvas);
  renderer.setSize(w, h);
  renderer.shadowMap.enabled = !isMobile;

  // Lighting
  scene.add(new THREE.AmbientLight(0xffffff, 0.2));
  const cyan = new THREE.PointLight(0x00F0FF, 3, 30);
  cyan.position.set(5,5,5); scene.add(cyan);
  const pink = new THREE.PointLight(0xFF5E7E, 2, 30);
  pink.position.set(-5,3,-3); scene.add(pink);

  // === ABSTRACT TECH DEVICE ===
  const device = new THREE.Group();

  // Main hexagonal platform
  const platGeo = new THREE.CylinderGeometry(2.5, 2.5, 0.2, 6);
  const platMat = new THREE.MeshStandardMaterial({
    color:0x111122, metalness:1, roughness:0.2,
    emissive:0x001122, emissiveIntensity:0.5
  });
  device.add(new THREE.Mesh(platGeo, platMat));

  // Platform edge glow
  const edgePlatGeo = new THREE.EdgesGeometry(platGeo);
  const edgePlatLine = new THREE.LineSegments(edgePlatGeo,
    new THREE.LineBasicMaterial({color:0x00F0FF, transparent:true, opacity:0.8}));
  device.add(edgePlatLine);

  // Central tower
  const tower = new THREE.Mesh(
    new THREE.CylinderGeometry(0.4, 0.6, 2.5, 8),
    new THREE.MeshStandardMaterial({color:0x223344, metalness:0.9, roughness:0.1, emissive:0x001133})
  );
  tower.position.y = 1.35;
  device.add(tower);

  // Tower top crystal
  const crystal = new THREE.Mesh(
    new THREE.OctahedronGeometry(0.6),
    new THREE.MeshStandardMaterial({
      color:0x00F0FF, metalness:0.9, roughness:0,
      emissive:0x00F0FF, emissiveIntensity:0.6, transparent:true, opacity:0.9
    })
  );
  crystal.position.y = 2.85;
  device.add(crystal);

  // Orbiting rings
  for (let i = 0; i < 3; i++) {
    const ringGeo = new THREE.TorusGeometry(1.5 + i*0.4, 0.04, 8, 64);
    const ringMat = new THREE.MeshStandardMaterial({
      color: i===1 ? 0xFF5E7E : 0x00F0FF,
      emissive: i===1 ? 0xFF5E7E : 0x00F0FF,
      emissiveIntensity:0.8
    });
    const ring = new THREE.Mesh(ringGeo, ringMat);
    ring.rotation.x = Math.PI/2 + (i*0.3);
    ring.rotation.z = i * 0.5;
    ring.userData.rotSpeed = (i+1)*0.008 * (i%2===0?1:-1);
    ring.userData.axis = i%2===0?'y':'x';
    ring.position.y = 1.5;
    device.add(ring);
  }

  // Small satellite cubes
  for (let i = 0; i < 5; i++) {
    const a = (i/5)*Math.PI*2;
    const sat = new THREE.Mesh(
      new THREE.BoxGeometry(0.25,0.25,0.25),
      new THREE.MeshStandardMaterial({color:0xFF5E7E,emissive:0xFF5E7E,emissiveIntensity:0.5})
    );
    sat.position.set(Math.cos(a)*3.2, 1.5, Math.sin(a)*3.2);
    sat.userData = {orbit: a, speed: 0.008+i*0.002, radius:3.2};
    device.add(sat);
  }

  scene.add(device);

  // === PULSATING WIREFRAME SPHERE ===
  const wireGeo = new THREE.SphereGeometry(4.5, 20, 20);
  const wireMat = new THREE.MeshBasicMaterial({
    color:0x00F0FF, wireframe:true, transparent:true, opacity:0.06
  });
  const wireSphere = new THREE.Mesh(wireGeo, wireMat);
  wireSphere.position.y = 1;
  scene.add(wireSphere);

  // Grid floor
  const grid = new THREE.GridHelper(12, 12, 0x00F0FF, 0x111133);
  grid.material.transparent = true; grid.material.opacity = 0.15;
  grid.position.y = -0.15;
  scene.add(grid);

  // Simple OrbitControls-like behavior
  let isDown=false, prevX=0, prevY=0, targetRotY=0, targetRotX=0, currentRotY=0, currentRotX=0;
  let autoRotate = true;
  canvas.addEventListener('mousedown', e => { isDown=true; prevX=e.clientX; prevY=e.clientY; autoRotate=false; });
  canvas.addEventListener('touchstart', e => { isDown=true; prevX=e.touches[0].clientX; prevY=e.touches[0].clientY; autoRotate=false; });
  window.addEventListener('mouseup', ()=>isDown=false);
  window.addEventListener('touchend', ()=>isDown=false);
  canvas.addEventListener('mousemove', e => {
    if (!isDown) return;
    targetRotY += (e.clientX-prevX)*0.005;
    targetRotX += (e.clientY-prevY)*0.005;
    targetRotX = Math.max(-0.8, Math.min(0.8, targetRotX));
    prevX=e.clientX; prevY=e.clientY;
  });
  canvas.addEventListener('touchmove', e => {
    if (!isDown) return;
    targetRotY += (e.touches[0].clientX-prevX)*0.005;
    prevX=e.touches[0].clientX;
  });
  // Wheel zoom
  let zoom = 8;
  canvas.addEventListener('wheel', e => {
    zoom = Math.max(4, Math.min(14, zoom + e.deltaY*0.01));
  }, {passive:true});

  let t = 0;
  const sectionObs = new IntersectionObserver(entries => {
    entries[0].target.dataset.visible = entries[0].isIntersecting ? '1' : '0';
  }, {threshold:0.1});
  sectionObs.observe(document.getElementById('showcase'));

  function animate() {
    requestAnimationFrame(animate);
    if (document.getElementById('showcase').dataset.visible === '0') return;
    t += 0.01;

    if (autoRotate) targetRotY += 0.005;
    currentRotY += (targetRotY - currentRotY) * 0.06;
    currentRotX += (targetRotX - currentRotX) * 0.06;

    device.rotation.y = currentRotY;
    device.rotation.x = currentRotX;

    // Orbit satellites
    device.children.forEach(ch => {
      if (ch.userData.orbit !== undefined) {
        ch.userData.orbit += ch.userData.speed;
        ch.position.set(
          Math.cos(ch.userData.orbit)*ch.userData.radius,
          1.5,
          Math.sin(ch.userData.orbit)*ch.userData.radius
        );
        ch.rotation.y += 0.05;
      }
      if (ch.userData.rotSpeed) {
        ch.rotation[ch.userData.axis] += ch.userData.rotSpeed;
      }
    });

    // Crystal pulse
    const scale = 1 + 0.08 * Math.sin(t*2);
    crystal.scale.set(scale,scale,scale);
    crystal.material.emissiveIntensity = 0.5 + 0.3*Math.sin(t*2);

    // Wireframe sphere pulse
    wireSphere.material.opacity = 0.04 + 0.04*Math.sin(t*0.5);
    wireSphere.rotation.y = t*0.03;
    wireSphere.rotation.x = t*0.02;

    // Cyan light pulse
    cyan.intensity = 2.5 + 1.5*Math.sin(t);

    camera.position.set(0, 2, zoom);
    camera.lookAt(0, 1, 0);
    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    const nw = canvas.offsetWidth;
    camera.aspect = nw/h; camera.updateProjectionMatrix();
    renderer.setSize(nw, h);
  });
})();

/* ===================================================
   SECTION 4: ABOUT – GLASS FLASKS WITH LIQUID
   3 flasks, vertex-shader-like wave, revolving
=================================================== */
(function initFlasks() {
  const canvas = document.getElementById('flask-canvas');
  if (!hasWebGL()) return;

  const scene = new THREE.Scene();
  const w = canvas.offsetWidth || 400;
  const h = 400;
  const camera = new THREE.PerspectiveCamera(55, w/h, 0.1, 100);
  camera.position.set(0, 1, 9);
  camera.lookAt(0,0,0);
  const renderer = createRenderer(canvas);
  renderer.setSize(w, h);

  scene.add(new THREE.AmbientLight(0xffffff, 0.3));
  const cyanLight = new THREE.PointLight(0x00F0FF, 3, 20);
  cyanLight.position.set(4,4,4); scene.add(cyanLight);
  const pinkLight = new THREE.PointLight(0xFF5E7E, 2, 20);
  pinkLight.position.set(-4,-2,-4); scene.add(pinkLight);

  const group = new THREE.Group();
  scene.add(group);

  const flaskColors = [
    {body:0x00F0FF, liquid:0x00AACC, emit:0x00F0FF},
    {body:0xFF5E7E, liquid:0xCC2244, emit:0xFF5E7E},
    {body:0xAAFFDD, liquid:0x00BB88, emit:0x00FFAA}
  ];
  const flasks = [];

  flaskColors.forEach((c, i) => {
    const flask = new THREE.Group();
    const x = (i-1)*2.5;

    // Flask body (cylinder)
    const bodyGeo = new THREE.CylinderGeometry(0.5, 0.6, 1.8, 16);
    const bodyMat = new THREE.MeshStandardMaterial({
      color:c.body, transparent:true, opacity:0.25,
      metalness:0.1, roughness:0, side:THREE.DoubleSide
    });
    flask.add(new THREE.Mesh(bodyGeo, bodyMat));

    // Flask neck
    const neckGeo = new THREE.CylinderGeometry(0.2, 0.35, 0.7, 12);
    const neckMat = new THREE.MeshStandardMaterial({
      color:c.body, transparent:true, opacity:0.2,
      metalness:0.1, roughness:0, side:THREE.DoubleSide
    });
    const neck = new THREE.Mesh(neckGeo, neckMat);
    neck.position.y = 1.25;
    flask.add(neck);

    // Liquid (animated)
    const liqGeo = new THREE.CylinderGeometry(0.45, 0.55, 0.9, 16, 8);
    const liqMat = new THREE.MeshStandardMaterial({
      color:c.liquid, emissive:c.emit, emissiveIntensity:0.5,
      transparent:true, opacity:0.8, metalness:0.2, roughness:0.3
    });
    const liquid = new THREE.Mesh(liqGeo, liqMat);
    liquid.position.y = -0.45;
    flask.add(liquid);
    // Store original verts for wave animation
    const origPos = liqGeo.attributes.position.array.slice();
    liquid.userData = {origPos, time:i*1.5};

    // Glow outline
    const outlineGeo = new THREE.CylinderGeometry(0.52, 0.62, 1.82, 16);
    const outlineMat = new THREE.MeshBasicMaterial({
      color:c.body, transparent:true, opacity:0.1, side:THREE.BackSide
    });
    flask.add(new THREE.Mesh(outlineGeo, outlineMat));

    // Bubbles
    for (let b = 0; b < 5; b++) {
      const bubble = new THREE.Mesh(
        new THREE.SphereGeometry(0.04+Math.random()*0.06,8,8),
        new THREE.MeshBasicMaterial({color:0xffffff,transparent:true,opacity:0.5})
      );
      bubble.position.set(
        (Math.random()-0.5)*0.7,
        -0.9 + Math.random()*1.4,
        (Math.random()-0.5)*0.7
      );
      bubble.userData.riseSpeed = 0.005+Math.random()*0.01;
      bubble.userData.startY = bubble.position.y;
      flask.add(bubble);
    }

    flask.position.x = x;
    flask.position.y = 0;
    group.add(flask);
    flasks.push({flask, liquid, liqGeo, i});
  });

  let t = 0;
  const secObs = new IntersectionObserver(entries => {
    entries[0].target.dataset.visible = entries[0].isIntersecting?'1':'0';
  }, {threshold:0.1});
  secObs.observe(document.getElementById('about'));

  function animate() {
    requestAnimationFrame(animate);
    if (document.getElementById('about').dataset.visible === '0') return;
    t += 0.016;

    // Revolve group
    group.rotation.y = Math.sin(t*0.3)*0.4;

    flasks.forEach(({flask, liquid, liqGeo, i}) => {
      // Bob
      flask.position.y = Math.sin(t*0.8 + i*2)*0.12;
      flask.rotation.z = Math.sin(t*0.5 + i)*0.05;

      // Wave liquid verts
      liquid.userData.time += 0.05;
      const pos = liqGeo.attributes.position.array;
      const orig = liquid.userData.origPos;
      for (let v = 0; v < pos.length/3; v++) {
        const ox = orig[v*3], oy = orig[v*3+1], oz = orig[v*3+2];
        if (oy > -0.1) { // top face
          pos[v*3+1] = oy + Math.sin(ox*3 + liquid.userData.time)*0.06 + Math.cos(oz*3 + liquid.userData.time*0.7)*0.04;
        }
      }
      liqGeo.attributes.position.needsUpdate = true;

      // Bubble rise
      flask.children.forEach(ch => {
        if (ch.userData.riseSpeed) {
          ch.position.y += ch.userData.riseSpeed;
          ch.material.opacity = 0.3 + Math.random()*0.2;
          if (ch.position.y > 0.6) ch.position.y = ch.userData.startY;
        }
      });
    });

    cyanLight.intensity = 2.5 + 1.5*Math.sin(t*1.5);
    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    const nw = canvas.offsetWidth;
    camera.aspect = nw/h; camera.updateProjectionMatrix();
    renderer.setSize(nw, h);
  });
})();

/* ===================================================
   SECTION 5: CONTACT – PARTICLE FIELD
   1500 dots attracted to mouse,
   explode to spell "SENT!" on submit
=================================================== */
(function initContact() {
  const canvas = document.getElementById('contact-canvas');
  if (!hasWebGL()) return;

  const scene = new THREE.Scene();
  const w = canvas.offsetWidth || 400;
  const h = 400;
  const camera = new THREE.PerspectiveCamera(55, w/h, 0.1, 100);
  camera.position.set(0, 0, 12);
  const renderer = createRenderer(canvas);
  renderer.setSize(w, h);

  // 1500 particle field
  const COUNT = isMobile ? 600 : 1500;
  const geo = new THREE.BufferGeometry();
  const positions = new Float32Array(COUNT*3);
  const basePositions = new Float32Array(COUNT*3);
  const velocities = new Float32Array(COUNT*3);
  const colors = new Float32Array(COUNT*3);

  for (let i=0;i<COUNT;i++) {
    const x=(Math.random()-0.5)*14; const y=(Math.random()-0.5)*10; const z=(Math.random()-0.5)*4;
    positions[i*3]=x; positions[i*3+1]=y; positions[i*3+2]=z;
    basePositions[i*3]=x; basePositions[i*3+1]=y; basePositions[i*3+2]=z;
    velocities[i*3]=0; velocities[i*3+1]=0; velocities[i*3+2]=0;
    const t=Math.random();
    colors[i*3]=t<0.5?0:1; colors[i*3+1]=t<0.5?0.94:0.37; colors[i*3+2]=t<0.5?1:0.49;
  }
  geo.setAttribute('position', new THREE.BufferAttribute(positions,3));
  geo.setAttribute('color', new THREE.BufferAttribute(colors,3));

  const mat = new THREE.PointsMaterial({
    size: isMobile?0.06:0.04, vertexColors:true,
    transparent:true, opacity:0.8, blending:THREE.AdditiveBlending
  });
  const points = new THREE.Points(geo, mat);
  scene.add(points);

  // Mouse attraction
  let mouse = {x:0, y:0};
  let exploding = false;
  let explodeT = 0;

  canvas.addEventListener('mousemove', e => {
    const rect = canvas.getBoundingClientRect();
    mouse.x = ((e.clientX-rect.left)/rect.width-0.5)*14;
    mouse.y = -((e.clientY-rect.top)/rect.height-0.5)*10;
  });
  canvas.addEventListener('touchmove', e => {
    const rect = canvas.getBoundingClientRect();
    mouse.x = ((e.touches[0].clientX-rect.left)/rect.width-0.5)*14;
    mouse.y = -((e.touches[0].clientY-rect.top)/rect.height-0.5)*10;
    e.preventDefault();
  }, {passive:false});

  // "SENT!" explosion pattern
  function getSentPositions() {
    // Simple letter dot patterns
    const letters = [];
    const S_pts = [
      [1,2],[2,2],[3,2],[3,1],[2,0],[1,0],[0,0],[0,-1],[1,-2],[2,-2],[3,-2]
    ];
    const E_pts = [[0,2],[1,2],[2,2],[0,1],[1,1],[0,0],[1,0],[2,0],[0,-1],[1,-1],[0,-2],[1,-2],[2,-2]];
    const N_pts = [[0,2],[0,1],[0,0],[0,-1],[0,-2],[1,1],[2,2],[2,1],[2,0],[2,-1],[2,-2]];
    const T_pts = [[0,2],[1,2],[2,2],[1,1],[1,0],[1,-1],[1,-2]];
    const bang = [[2.5,2],[2.5,1],[2.5,0],[2.5,-2]];

    const offsets = [{dx:-6},{dx:-3.5},{dx:-1},{dx:1.5},{dx:4.5}];
    const allPts = [S_pts,E_pts,N_pts,T_pts,bang];
    let result=[];
    allPts.forEach((pts,li)=>{
      pts.forEach(([px,py])=>{
        result.push({x:(px+offsets[li].dx)*0.55, y:py*0.55, z:0});
      });
    });
    return result;
  }

  let sentPositions = [];
  window.triggerContactExplode = function() {
    exploding = true; explodeT = 0;
    sentPositions = getSentPositions();
    // Map particles to sent positions
    const extra = COUNT - sentPositions.length;
    for (let i=0;i<COUNT;i++) {
      if (i < sentPositions.length) {
        positions[i*3+2] = 0;
      }
    }
  };

  const secObs2 = new IntersectionObserver(entries => {
    entries[0].target.dataset.visible = entries[0].isIntersecting?'1':'0';
  }, {threshold:0.1});
  secObs2.observe(document.getElementById('contact'));

  let t=0;
  function animate() {
    requestAnimationFrame(animate);
    if (document.getElementById('contact').dataset.visible === '0') return;
    t += 0.01;

    const pos = geo.attributes.position.array;

    if (!exploding) {
      for (let i=0;i<COUNT;i++) {
        const dx=mouse.x-pos[i*3]; const dy=mouse.y-pos[i*3+1];
        const dist=Math.sqrt(dx*dx+dy*dy)+0.01;
        const force = Math.max(0, 1-dist/4)*0.008;
        velocities[i*3]+=dx/dist*force;
        velocities[i*3+1]+=dy/dist*force;
        // Spring back
        velocities[i*3]+=(basePositions[i*3]-pos[i*3])*0.003;
        velocities[i*3+1]+=(basePositions[i*3+1]-pos[i*3+1])*0.003;
        // Damping
        velocities[i*3]*=0.92; velocities[i*3+1]*=0.92;
        pos[i*3]+=velocities[i*3]; pos[i*3+1]+=velocities[i*3+1];
        // Z ripple
        pos[i*3+2]=Math.sin(t+i*0.01)*0.3;
      }
    } else {
      explodeT += 0.02;
      for (let i=0;i<COUNT;i++) {
        let tx, ty, tz;
        if (i < sentPositions.length) {
          tx=sentPositions[i].x; ty=sentPositions[i].y; tz=0;
        } else {
          // Scatter outward
          const angle=basePositions[i*3+2]*123;
          const r=8+Math.random()*2;
          tx=Math.cos(angle+explodeT)*r*(explodeT);
          ty=Math.sin(angle+explodeT)*r*(explodeT)*0.5;
          tz=0;
        }
        pos[i*3]+=(tx-pos[i*3])*0.05;
        pos[i*3+1]+=(ty-pos[i*3+1])*0.05;
        pos[i*3+2]+=(tz-pos[i*3+2])*0.05;
      }
      if (explodeT>4) {
        // Reset
        for(let i=0;i<COUNT;i++){
          pos[i*3]=basePositions[i*3];
          pos[i*3+1]=basePositions[i*3+1];
          pos[i*3+2]=basePositions[i*3+2];
        }
        exploding=false; explodeT=0;
      }
    }

    geo.attributes.position.needsUpdate = true;
    points.rotation.z = t*0.01;
    renderer.render(scene, camera);
  }
  animate();

  window.addEventListener('resize', () => {
    const nw=canvas.offsetWidth;
    camera.aspect=nw/h; camera.updateProjectionMatrix();
    renderer.setSize(nw,h);
  });
})();

/* ===================================================
   CONTACT FORM SUBMIT
=================================================== */
function handleSubmit() {
  const name=document.getElementById('f-name').value.trim();
  const email=document.getElementById('f-email').value.trim();
  const msg=document.getElementById('f-msg').value.trim();
  if (!name||!email||!msg) {
    alert('Please fill in all fields.');
    return;
  }
  const btn=document.getElementById('submit-btn');
  btn.disabled=true; btn.textContent='Sending...';
  setTimeout(()=>{
    document.getElementById('contact-form-area').style.display='none';
    document.getElementById('sent-message').style.display='block';
    if (window.triggerContactExplode) window.triggerContactExplode();
  }, 800);
}

/* ===================================================
   COUNTER ANIMATION (Stats)
=================================================== */
const statNums = document.querySelectorAll('.stat-num[data-count]');
const countObs = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (e.isIntersecting) {
      const el=e.target; const target=+el.dataset.count;
      let curr=0; const step=target/60;
      const interval=setInterval(()=>{
        curr=Math.min(curr+step, target);
        el.textContent=Math.round(curr)+(el.dataset.count==='98'?'%':'+');
        if(curr>=target) clearInterval(interval);
      }, 16);
      countObs.unobserve(el);
    }
  });
},{threshold:0.5});
statNums.forEach(el=>countObs.observe(el));

/* ===================================================
   PERFORMANCE: IntersectionObserver for 3D sections
   (already implemented per-scene above)
=================================================== */
// Initialize visibility flags
document.getElementById('showcase').dataset.visible='0';
document.getElementById('about').dataset.visible='0';
document.getElementById('contact').dataset.visible='0';
</script>
</body>
</html>
